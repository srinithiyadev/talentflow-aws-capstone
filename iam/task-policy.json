{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TalentFlowDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:872575360511:table/Candidates",
        "arn:aws:dynamodb:us-east-1:872575360511:table/Jobs",
        "arn:aws:dynamodb:us-east-1:872575360511:table/Interviews"
      ]
    }
  ]
}
